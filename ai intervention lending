  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth; scroll-padding-top:70px;}
  body{font-family:'Segoe UI',Calibri,Arial,sans-serif; background:var(--bg); color:var(--ink); line-height:1.5;}


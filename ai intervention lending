  nav{position:sticky; top:0; z-index:100; background:var(--navy); box-shadow:0 2px 10px rgba(0,0,0,.25);}
  nav .wrap{max-width:1250px; margin:0 auto; display:flex; align-items:center; gap:4px; padding:0 16px; overflow-x:auto;}
  nav .brand{color:#fff; font-weight:700; font-size:.85rem; white-space:nowrap; padding:14px 14px 14px 0; border-right:1px solid rgba(255,255,255,.2); margin-right:6px;}
  nav a{color:#C9D6EC; text-decoration:none; font-size:.78rem; padding:14px 10px; white-space:nowrap; border-bottom:3px solid transparent;}
  nav a:hover{color:#fff; border-bottom-color:var(--orange);}

  .page{max-width:1250px; margin:0 auto; padding:0 20px 80px;}

  /* ===== HERO ===== */
  header.hero{background:linear-gradient(135deg,var(--navy) 0%,#2a4d8f 60%,var(--blue) 100%); color:#fff; border-radius:0 0 18px 18px; padding:46px 40px 38px; margin-bottom:34px;}
  header.hero h1{font-size:2rem; margin-bottom:8px;}
  header.hero p.sub{font-size:1.05rem; color:#D9E5F5;}
  header.hero p.meta{margin-top:14px; font-size:.8rem; color:#AFC4E3;}
  .hero-stats{display:flex; gap:16px; margin-top:22px; flex-wrap:wrap;}
  .hero-stat{background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.25); border-radius:10px; padding:12px 18px; min-width:170px;}
  .hero-stat b{display:block; font-size:1.15rem;}
  .hero-stat span{font-size:.75rem; color:#C9D6EC;}

  /* ===== SECTIONS ===== */
  section{margin-bottom:46px;}
  h2{color:var(--navy); font-size:1.4rem; margin-bottom:6px; padding-bottom:8px; border-bottom:3px solid var(--orange); display:inline-block;}
  .h2row{display:flex; align-items:baseline; gap:12px; margin-bottom:14px;}
  .secnum{background:var(--orange); color:#fff; font-weight:700; border-radius:8px; padding:4px 12px; font-size:1rem;}
  h3{color:var(--blue); font-size:1.05rem; margin:22px 0 10px;}
  p.lead{color:var(--grey); font-size:.92rem; max-width:950px; margin-bottom:14px;}
  p.lead em{color:var(--orange); font-style:normal; font-weight:600;}

  /* ===== TABLES ===== */
  .tblwrap{overflow-x:auto; border-radius:12px; box-shadow:0 1px 6px rgba(31,56,100,.10); background:var(--card);}
  table{width:100%; border-collapse:collapse; font-size:.83rem;}
  thead th{background:var(--navy); color:#fff; text-align:left; padding:10px 12px; font-size:.78rem; letter-spacing:.03em; text-transform:uppercase;}
  tbody td{padding:10px 12px; border-bottom:1px solid var(--line); vertical-align:top;}
  tbody tr:nth-child(even){background:#F2F6FB;}
  tbody tr:hover{background:var(--lblue);}
  td .tag{display:inline-block; background:var(--lblue); color:var(--navy); border-radius:20px; padding:2px 10px; font-size:.72rem; font-weight:600; margin:1px 2px 1px 0; white-space:nowrap;}
  td .tag.or{background:var(--lorange); color:var(--orange);}
  td .tag.gr{background:var(--lgreen); color:var(--green);}
  td .tag.rd{background:var(--lred); color:var(--red);}
  .up{color:var(--green); font-weight:700;} .down{color:var(--blue); font-weight:700;}

  /* ===== OPERATING MODEL DIAGRAM ===== */
  .om{display:grid; grid-template-columns:1fr 1fr; gap:22px; margin-top:18px;}
  .om .center{grid-column:1/3; justify-self:center; background:var(--navy); color:#fff; border-radius:14px; padding:18px 34px; text-align:center; box-shadow:0 4px 14px rgba(31,56,100,.35); position:relative;}
  .om .center h4{font-size:1.05rem; letter-spacing:.05em;}
  .om .center p{font-size:.78rem; color:#C9D6EC; margin-top:4px;}
  .face{background:var(--card); border-radius:14px; overflow:hidden; box-shadow:0 2px 10px rgba(31,56,100,.12); border-top:5px solid;}
  .face .hd{padding:12px 16px; color:#fff; font-weight:700; font-size:.9rem; display:flex; justify-content:space-between; align-items:center;}
  .face .hd .why{font-size:.7rem; font-weight:400; font-style:italic; opacity:.9;}
  .face ul{list-style:none; padding:12px 16px;}
  .face li{font-size:.82rem; padding:4px 0 4px 18px; position:relative;}
  .face li::before{content:"▸"; position:absolute; left:0; font-weight:700;}
  .f1{border-color:var(--blue);} .f1 .hd{background:var(--blue);} .f1 li::before{color:var(--blue);}
  .f2{border-color:var(--orange);} .f2 .hd{background:var(--orange);} .f2 li::before{color:var(--orange);}
  .f3{border-color:var(--green); grid-column:1/3; max-width:560px; justify-self:center; width:100%;} .f3 .hd{background:var(--green);} .f3 li::before{color:var(--green);}

  /* ===== INTERVENTION CARDS ===== */
  .cards{display:grid; grid-template-columns:repeat(auto-fill,minmax(360px,1fr)); gap:16px;}
  .icard{background:var(--card); border-radius:12px; box-shadow:0 1px 6px rgba(31,56,100,.10); padding:16px 18px; border-left:5px solid var(--blue); display:flex; flex-direction:column; gap:8px;}
  .icard .top{display:flex; align-items:center; gap:10px;}
  .icard .idb{background:var(--navy); color:#fff; font-weight:700; border-radius:8px; padding:3px 10px; font-size:.8rem;}
  .icard h4{font-size:.98rem; color:var(--navy);}
  .icard p.does{font-size:.83rem; color:#333;}
  .icard .meta{display:flex; flex-wrap:wrap; gap:6px; margin-top:auto; padding-top:6px; border-top:1px dashed var(--line);}
  .pill{font-size:.7rem; border-radius:20px; padding:2px 10px; font-weight:600;}
  .pill.who{background:var(--lblue); color:var(--navy);}
  .pill.psy{background:var(--lorange); color:var(--orange);}
  .pill.met{background:var(--lgreen); color:var(--green);}

  /* ===== ESCALATION LADDER ===== */
  .ladder{display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-top:16px; position:relative;}
  .ladder::after{content:""; position:absolute; left:2%; right:2%; bottom:26px; height:4px; background:linear-gradient(90deg,var(--blue),var(--orange),var(--red)); border-radius:2px; z-index:0;}
  .step{display:flex; flex-direction:column; gap:8px; position:relative; z-index:1;}
  .step .box{background:var(--card); border-radius:12px; border-top:5px solid; padding:12px 12px 10px; box-shadow:0 2px 8px rgba(31,56,100,.12); flex:1;}
  .step .box b{display:block; font-size:.8rem; margin-bottom:5px;}
  .step .box p{font-size:.75rem; color:#333;}
  .step .trig{font-size:.72rem; font-style:italic; color:var(--grey); text-align:center; min-height:32px;}
  .step .day{align-self:center; background:var(--navy); color:#fff; font-weight:700; font-size:.78rem; border-radius:8px; padding:6px 14px;}
  .s1 .box{border-color:var(--blue);} .s1 .box b{color:var(--blue);}
  .s2 .box{border-color:var(--blue);} .s2 .box b{color:var(--blue);}
  .s3 .box{border-color:var(--orange);} .s3 .box b{color:var(--orange);}
  .s4 .box{border-color:var(--orange);} .s4 .box b{color:var(--orange);}
  .s5 .box{border-color:var(--red);} .s5 .box b{color:var(--red);}

  /* ===== CALLOUT ===== */
  .callout{background:var(--lorange); border-left:5px solid var(--orange); border-radius:0 10px 10px 0; padding:12px 18px; font-size:.88rem; margin:14px 0; max-width:1000px;}
  .callout.blue{background:var(--lblue); border-color:var(--blue);}
  .callout.green{background:var(--lgreen); border-color:var(--green);}

  /* ===== PHASE TIMELINE ===== */
  .phases{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:16px;}
  .phase{background:var(--card); border-radius:12px; box-shadow:0 2px 8px rgba(31,56,100,.12); overflow:hidden;}
  .phase .ph{padding:12px 16px; color:#fff; font-weight:700; font-size:.9rem;}
  .phase:nth-child(1) .ph{background:var(--navy);} .phase:nth-child(2) .ph{background:var(--blue);} .phase:nth-child(3) .ph{background:var(--orange);} .phase:nth-child(4) .ph{background:var(--green);}
  .phase .bd{padding:14px 16px; font-size:.82rem; display:flex; flex-direction:column; gap:8px;}
  .phase .bd b{color:var(--navy); font-size:.75rem; text-transform:uppercase; letter-spacing:.04em;}

  /* ===== GUARDRAILS ===== */
  .guards{display:grid; grid-template-columns:repeat(auto-fill,minmax(360px,1fr)); gap:14px;}
  .guard{background:var(--card); border-radius:12px; box-shadow:0 1px 6px rgba(31,56,100,.10); padding:14px 16px; border-left:5px solid var(--red);}
  .guard b{color:var(--red); font-size:.85rem; display:block; margin-bottom:4px;}
  .guard p{font-size:.82rem;}

  .totop{position:fixed; right:22px; bottom:22px; background:var(--orange); color:#fff; text-decoration:none; border-radius:50%; width:44px; height:44px; display:flex; align-items:center; justify-content:center; font-size:1.2rem; box-shadow:0 4px 12px rgba(0,0,0,.3);}

  @media(max-width:860px){
    .ladder{grid-template-columns:1fr;} .ladder::after{display:none;}
    .om{grid-template-columns:1fr;} .om .center,.f3{grid-column:1;}
    .phases{grid-template-columns:1fr;}
    header.hero{padding:30px 22px;}
  }
</style>

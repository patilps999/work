<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agentic AI in Indian Lending — Practitioner Dossier</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#16212E;--ink2:#33414F;--muted:#6B7785;--paper:#F4F5F6;--card:#FFF;--line:#DDE2E7;--line2:#E9ECEF;--accent:#B26B2E;--accent-soft:#F3E7D8;
--c0:#8C8574;--c1:#6E8CA6;--c2:#3D6699;--c3:#3E8A6B;--c4:#7B5AA6;--build:#2c6a4d;--split:#8a6a15;--wait:#a2542f;
--fd:'Space Grotesk',system-ui,sans-serif;--fb:'Newsreader',Georgia,serif;--fm:'IBM Plex Mono',monospace;}
*{box-sizing:border-box}html{scroll-behavior:smooth}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--fb);font-size:17.5px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
h1,h2,h3,h4{font-family:var(--fd);font-weight:600;letter-spacing:-.02em;line-height:1.08;color:var(--ink)}
.wrap{display:grid;grid-template-columns:268px minmax(0,1fr);max-width:1300px;margin:0 auto}
.side{position:sticky;top:0;height:100vh;overflow-y:auto;padding:32px 24px;border-right:1px solid var(--line);background:var(--paper)}
.brand{font-family:var(--fd);font-weight:700;font-size:15px;line-height:1.25}.brand b{color:var(--accent)}
.brand-sub{font-family:var(--fm);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:2px 0 22px}
nav.toc{margin-bottom:24px}
nav.toc a{display:flex;gap:10px;align-items:baseline;padding:6px 0;color:var(--ink2);font-family:var(--fd);font-size:13.5px;font-weight:500}
nav.toc a .n{font-family:var(--fm);font-size:10.5px;color:var(--muted);min-width:20px}
nav.toc a:hover{color:var(--ink);text-decoration:none}
nav.toc a.active,nav.toc a.active .n{color:var(--accent)}
.keybox{border-top:1px solid var(--line);padding-top:16px}
.keybox h4{font-family:var(--fm);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 11px}
.keyrow{display:flex;gap:9px;align-items:flex-start;margin-bottom:10px}
.keyrow div{font-size:12px;line-height:1.3;color:var(--ink2);font-family:var(--fd)}
.keyrow div span{display:block;color:var(--muted);font-size:10.5px}
.chip{display:inline-block;font-family:var(--fm);font-size:11px;font-weight:600;padding:2px 7px;border-radius:5px;color:#fff;white-space:nowrap}
.chip-C0{background:var(--c0)}.chip-C1{background:var(--c1)}.chip-C2{background:var(--c2)}.chip-C3{background:var(--c3)}.chip-C4{background:var(--c4)}.chip-multi{background:#5b6673}
.mat{display:inline-block;font-family:var(--fm);font-size:10.5px;font-weight:600;padding:2px 7px;border-radius:20px;border:1px solid;white-space:nowrap}
.mat-production{color:#2c6a4d;border-color:#bfe0cd;background:#eaf5ef}.mat-piloted{color:#8a6a15;border-color:#ecd9a8;background:#fbf3df}
.mat-claimed{color:#a23b32;border-color:#e6c3bf;background:#f8ebe9}.mat-widespread{color:#4a5560;border-color:#d7dde2;background:#eef1f3}
main{padding:0 clamp(20px,4.5vw,64px) 110px;min-width:0}
section{padding-top:66px;scroll-margin-top:16px}
.sec-head{display:flex;align-items:baseline;gap:13px;margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.sec-head .num{font-family:var(--fm);font-size:12.5px;color:var(--accent);font-weight:600}
.sec-head h2{font-size:clamp(1.5rem,3vw,2rem);margin:0}
p.lede{font-size:1.1rem;color:var(--ink2);margin:0 0 18px;max-width:74ch}
main p{max-width:72ch}
.small{font-family:var(--fm);font-size:11px;letter-spacing:.04em;color:var(--muted);text-transform:uppercase}
.hero{padding-top:46px}
.hero .eyebrow{font-family:var(--fm);font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:16px}
.hero h1{font-size:clamp(2.2rem,5.4vw,3.7rem);margin:0 0 18px}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero .sub{font-size:1.18rem;color:var(--ink2);max-width:66ch;margin:0 0 30px}
.spectrum{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:28px 0 20px}
.seg{background:var(--card);border:1px solid var(--line);border-top:3px solid;border-radius:9px;padding:13px 13px 11px}
.seg-c0{border-top-color:var(--c0)}.seg-c1{border-top-color:var(--c1)}.seg-c2{border-top-color:var(--c2)}.seg-c3{border-top-color:var(--c3)}.seg-c4{border-top-color:var(--c4)}
.seg-code{font-family:var(--fm);font-weight:600;font-size:12.5px}
.seg-c0 .seg-code,.seg-c0 .seg-band{color:var(--c0)}.seg-c1 .seg-code,.seg-c1 .seg-band{color:var(--c1)}.seg-c2 .seg-code,.seg-c2 .seg-band{color:var(--c2)}.seg-c3 .seg-code,.seg-c3 .seg-band{color:var(--c3)}.seg-c4 .seg-code,.seg-c4 .seg-band{color:var(--c4)}
.seg-name{display:block;font-family:var(--fd);font-weight:600;font-size:14.5px;margin-top:3px}
.seg-sub{display:block;font-size:11.5px;color:var(--muted);margin-top:2px;font-family:var(--fd)}
.seg-band{display:block;font-family:var(--fm);font-size:9px;letter-spacing:.08em;text-transform:uppercase;margin-top:10px;padding-top:8px;border-top:1px solid var(--line2)}
.spec-axis{display:flex;justify-content:space-between;font-family:var(--fm);font-size:10.5px;color:var(--muted);margin-bottom:30px}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--fm);font-size:11.5px;color:var(--ink2);border-top:1px solid var(--line);padding-top:18px}
.hero-meta b{color:var(--accent)}
.leg-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(225px,1fr));gap:12px;margin-top:6px}
.leg{background:var(--card);border:1px solid var(--line);border-left:4px solid;border-radius:10px;padding:16px}
.leg-c0{border-left-color:var(--c0)}.leg-c1{border-left-color:var(--c1)}.leg-c2{border-left-color:var(--c2)}.leg-c3{border-left-color:var(--c3)}.leg-c4{border-left-color:var(--c4)}
.leg-c0 .leg-code,.leg-c0 .leg-ag{color:var(--c0)}.leg-c1 .leg-code,.leg-c1 .leg-ag{color:var(--c1)}.leg-c2 .leg-code,.leg-c2 .leg-ag{color:var(--c2)}.leg-c3 .leg-code,.leg-c3 .leg-ag{color:var(--c3)}.leg-c4 .leg-code,.leg-c4 .leg-ag{color:var(--c4)}
.leg-top{display:flex;gap:11px;align-items:flex-start;margin-bottom:10px}
.leg-code{font-family:var(--fm);font-weight:700;font-size:19px;line-height:1}
.leg-top h3{font-size:16px;margin:0}
.leg-era{font-family:var(--fm);font-size:10.5px;color:var(--muted);margin:3px 0 0}
.leg-what{font-size:14px;color:var(--ink2);margin:0 0 10px;line-height:1.45}
.leg-tell{font-size:13.5px;color:var(--ink);margin:0 0 10px;line-height:1.42;background:var(--paper);padding:9px 11px;border-radius:7px}
.leg-tell .lbl{display:block;font-family:var(--fm);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:2px}
.leg-ag{font-family:var(--fd);font-weight:600;font-size:13px;margin:0}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--card);margin-top:6px}
table{border-collapse:collapse;width:100%;font-size:14px}
thead th{font-family:var(--fm);font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);text-align:left;padding:13px 15px;border-bottom:1px solid var(--line);font-weight:600;background:#fbfbfc}
tbody td{padding:13px 15px;border-bottom:1px solid var(--line2);vertical-align:top;font-family:var(--fd);line-height:1.4}
tbody tr:last-child td{border-bottom:0}tbody tr:hover{background:#fafbfc}
.eyebrow{display:block;font-family:var(--fm);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:3px}
.uc{display:block;font-weight:600;font-size:14px;color:var(--ink)}
.what{display:block;font-size:12px;color:var(--muted);margin-top:2px;line-height:1.35}
.c-uc{min-width:205px}.c-verdict{font-size:12.5px;color:var(--ink2);min-width:180px}
.c-verdict.verdict-c4{color:var(--c4);font-weight:600}
.c-rbi{font-size:12px;color:var(--ink2);min-width:160px}
.mat-note{display:block;font-family:var(--fm);font-size:10px;color:var(--muted);margin-top:4px}
.filters{display:flex;flex-wrap:wrap;gap:16px;margin:4px 0 14px;align-items:center}
.fgroup{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.fgroup .flabel{font-family:var(--fm);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.fbtn{font-family:var(--fm);font-size:11.5px;font-weight:600;padding:5px 10px;border-radius:20px;border:1px solid var(--line);background:var(--card);color:var(--ink2);cursor:pointer;transition:all .14s ease}
.fbtn:hover{border-color:var(--ink2);color:var(--ink)}
.fbtn.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.fbtn[data-class="C0"].on{background:var(--c0);border-color:var(--c0)}.fbtn[data-class="C1"].on{background:var(--c1);border-color:var(--c1)}
.fbtn[data-class="C2"].on{background:var(--c2);border-color:var(--c2)}.fbtn[data-class="C3"].on{background:var(--c3);border-color:var(--c3)}
.fbtn[data-class="C4"].on{background:var(--c4);border-color:var(--c4)}
.count{font-family:var(--fm);font-size:11px;color:var(--muted);margin-left:auto}
tr.hide{display:none}
.callout{background:var(--ink);color:#e8ecf0;border-radius:14px;padding:24px 28px;margin:22px 0}
.callout h3{color:#fff;font-size:18px;margin:0 0 10px}
.callout p{color:#c3ccd4;max-width:none;margin:0 0 8px;font-size:15px}
.callout .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(115px,1fr));gap:14px;margin-top:16px;border-top:1px solid #2a3947;padding-top:16px}
.callout .stat b{font-family:var(--fd);font-size:24px;color:#fff;display:block}
.callout .stat span{font-size:11.5px;color:#9aa7b2;line-height:1.3;display:block;margin-top:2px}
.firm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:12px;margin-top:6px}
.firm{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:18px}
.firm h3{font-size:15.5px;margin:0 0 8px;color:var(--accent)}
.firm p{font-size:13.5px;color:var(--ink2);margin:0;max-width:none;line-height:1.48}
.consensus{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:6px 22px;margin:6px 0 18px}
.consensus ul{margin:0;padding:0}
.consensus li{padding:11px 0;border-bottom:1px solid var(--line2);list-style:none;font-size:14.5px;color:var(--ink2)}
.consensus li:last-child{border-bottom:0}
.consensus li b{color:var(--ink);font-family:var(--fd);font-weight:600}
.dv-claim{font-family:var(--fd);font-weight:600;color:var(--ink);width:35%}
.dv-real{color:var(--ink2);font-size:13.5px}
.ml-say{font-family:var(--fd);font-weight:600;color:var(--ink)}.ml-why{color:var(--ink2);font-size:13px}
.verdict-band{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:6px 0 20px}
.vcard{border-radius:12px;padding:20px 22px}
.vcard.good{background:#eef5f0;border:1px solid #cfe4d6}.vcard.bad{background:#f6eeea;border:1px solid #e6d3c8}
.vcard h3{font-size:15.5px;margin:0 0 8px}.vcard.good h3{color:#2c6a4d}.vcard.bad h3{color:#a2542f}
.vcard p{font-size:14px;color:var(--ink2);margin:0;max-width:none}
.bn{font-family:var(--fm);color:var(--muted);font-size:12.5px;width:22px}
.bc{min-width:215px}.bv{font-size:12.5px;color:var(--ink2);min-width:180px}
.flag{background:var(--accent-soft);border:1px solid #e6d3b8;border-radius:12px;padding:18px 22px;margin:20px 0}
.flag h3{font-size:14.5px;margin:0 0 8px;color:#8a5316}
.flag ul{margin:0;padding-left:18px;color:var(--ink2);font-size:14px}
.flag li{margin-bottom:6px}
.assume{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:10px;padding:14px 18px;margin:0 0 18px}
.assume h4{margin:0 0 6px;font-size:10.5px;font-family:var(--fm);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.assume p{margin:0;font-size:14px;color:var(--ink2);max-width:none}
.vbadge{display:inline-block;font-family:var(--fm);font-size:11px;font-weight:600;padding:5px 10px;border-radius:7px;white-space:nowrap;line-height:1.2}
.v-build{background:#eaf5ef;color:var(--build);border:1px solid #bfe0cd}
.v-split{background:#fbf3df;color:var(--split);border:1px solid #ecd9a8}
.v-wait{background:#f8ebe9;color:var(--wait);border:1px solid #e6c3bf}
.summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:9px;margin:8px 0 20px}
.sm{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 14px;border-top:3px solid}
.sm-build{border-top-color:var(--build)}.sm-split{border-top-color:var(--split)}.sm-wait{border-top-color:var(--wait)}
.sm-v{font-family:var(--fm);font-size:10.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
.sm-build .sm-v{color:var(--build)}.sm-split .sm-v{color:var(--split)}.sm-wait .sm-v{color:var(--wait)}
.sm-n{display:block;font-family:var(--fd);font-weight:600;font-size:13.5px;margin-top:5px;line-height:1.25;color:var(--ink)}
.crit-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:6px 0 22px}
.crit{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;display:flex;gap:12px}
.crit-n{font-family:var(--fm);font-size:12.5px;font-weight:600;color:var(--accent)}
.crit h4{margin:0 0 4px;font-size:14.5px}
.crit p{margin:0;font-size:13px;color:var(--ink2);line-height:1.42;max-width:none}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px 24px;margin-top:16px;scroll-margin-top:16px}
.card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}
.card-title h3{font-size:19px;margin:0 0 4px}
.csub{margin:0;font-size:13.5px;color:var(--muted);max-width:60ch;line-height:1.4}
.card-meta{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin:13px 0 4px}
.mtag{font-family:var(--fm);font-size:10.5px;color:var(--muted);border:1px solid var(--line);border-radius:20px;padding:2px 9px}
.mtag-cost{color:var(--ink);background:var(--paper);border-color:#cfd6dc;font-weight:600}
.gauge{margin:14px 0 18px}
.track{position:relative;height:42px;background:linear-gradient(90deg,#f8ebe9,#fbf3df 45%,#eef6f1);border:1px solid var(--line);border-radius:10px}
.track .stop{position:absolute;top:50%;transform:translate(-50%,-50%);font-family:var(--fm);font-size:10px;color:#9098a1;pointer-events:none}
.fill{position:absolute;top:0;bottom:0;left:0;border-radius:10px 0 0 10px;opacity:.14}
.fill-build{background:var(--build)}.fill-split{background:var(--split)}.fill-wait{background:var(--wait)}
.dot{position:absolute;top:50%;width:15px;height:15px;border-radius:50%;transform:translate(-50%,-50%);border:3px solid #fff;box-shadow:0 2px 8px rgba(20,33,46,.3);z-index:2}
.dot-build{background:var(--build)}.dot-split{background:var(--split)}.dot-wait{background:var(--wait)}
.fw{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:4px 0 16px}
.fw-col{border-radius:10px;padding:13px 15px}
.fw-build{background:#f1f7f3;border:1px solid #d8e8de}.fw-wait{background:#f8f1ee;border:1px solid #ecdcd4}
.fw-col h4{margin:0 0 7px;font-size:11px;font-family:var(--fm);letter-spacing:.06em;text-transform:uppercase}
.fw-build h4{color:var(--build)}.fw-wait h4{color:var(--wait)}
.fw-col ul{margin:0;padding-left:15px}
.fw-col li{font-size:13px;color:var(--ink2);line-height:1.42;margin-bottom:7px}
.fw-col li:last-child{margin-bottom:0}
.hfs{background:var(--ink);border-radius:11px;padding:16px 20px;color:#dbe2e8}
.hfs-lbl{font-family:var(--fm);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);font-weight:600}
.hfs p{margin:7px 0 0;color:#e8ecf0;font-size:14.5px;line-height:1.48;max-width:none}
.hfs strong{color:#fff}.hfs em{color:#f0d9bd;font-style:normal}
.moves{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:14px;border-top:1px solid #2a3947;padding-top:12px}
.moves .mv{display:block;font-family:var(--fm);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:#8fa0ad;margin-bottom:3px}
.moves div{font-size:12.5px;color:#cdd5dd;line-height:1.4}
.mx-uc{font-weight:600;color:var(--ink);min-width:175px}.mx-econ,.mx-move{color:var(--ink2);font-size:12px}
/* vendors */
.vd-layer{font-family:var(--fd);font-weight:600;color:var(--ink);min-width:170px}
.vd-names{font-family:var(--fm);font-size:12px;color:var(--ink2);min-width:200px}
.vd-note{font-size:12.5px;color:var(--ink2);min-width:220px}
/* diligence */
.dil{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 26px;counter-reset:q}
.dil li{list-style:none;counter-increment:q;padding:12px 0 12px 38px;border-bottom:1px solid var(--line2);font-size:14.5px;color:var(--ink);position:relative;font-family:var(--fd)}
.dil li:last-child{border-bottom:0}
.dil li::before{content:counter(q,decimal-leading-zero);position:absolute;left:0;top:12px;font-family:var(--fm);font-size:12px;font-weight:600;color:var(--accent)}
/* roadmap */
.road{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px 22px;margin-top:14px}
.road-head{display:flex;align-items:baseline;gap:12px;margin-bottom:10px}
.road-q{font-family:var(--fm);font-size:11px;font-weight:600;color:#fff;background:var(--accent);border-radius:6px;padding:3px 9px;white-space:nowrap}
.road h3{font-size:16px;margin:0}
.road ul{margin:0;padding-left:18px}
.road li{font-size:14px;color:var(--ink2);line-height:1.5;margin-bottom:6px}
/* free-ai */
.fa-item{font-family:var(--fd);font-weight:600;color:var(--ink)}
.fa-ev{font-size:12.5px;color:var(--ink2)}
.fa-own{font-family:var(--fm);font-size:11.5px;color:var(--muted);white-space:nowrap}
.bl{background:var(--ink);color:#e8ecf0;border-radius:16px;padding:30px 34px;margin-top:6px}
.bl h2{color:#fff}.bl p{color:#c8d0d8;max-width:72ch;font-size:15.5px}.bl strong{color:#fff}
.bl .kicker{font-family:var(--fm);font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:12px}
.src{font-family:var(--fm);font-size:12px;color:var(--muted);line-height:1.8}
footer{margin-top:50px;padding-top:20px;border-top:1px solid var(--line);font-family:var(--fm);font-size:10.5px;color:var(--muted);line-height:1.7}
.mtop{display:none}
@media(max-width:1000px){
 .wrap{grid-template-columns:1fr}.side{display:none}
 .mtop{display:flex;position:sticky;top:0;z-index:20;background:var(--paper);border-bottom:1px solid var(--line);padding:11px 16px;gap:13px;align-items:center;overflow-x:auto;white-space:nowrap}
 .mtop .brand{margin:0;font-size:12.5px}
 .mtop a{font-family:var(--fd);font-size:12.5px;color:var(--ink2);font-weight:500}
